# ═══════════════════════════════════════════════════════
# CrisisLens — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is in .gitignore.
# ═══════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────────────
# Required for persistent storage.
# Create a free cluster at https://cloud.mongodb.com
# 1. Create a cluster
# 2. Create a database user (Database Access → Add New Database User)
# 3. Allow your IP (Network Access → Add IP Address → Allow Access from Anywhere for dev)
# 4. Get connection string (Connect → Drivers → Node.js)
# 5. Replace <username>, <password>, <cluster> below
#
# Without this variable, the app runs in demo-only mode with in-memory data.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/crisislens?retryWrites=true&w=majority

# ─── AI Provider — Open-Source Model ─────────────────────
# Choose ONE provider and set its API key.
# Without an AI provider, the app uses pre-computed demo responses.

# Option 1: OpenRouter (hosted Gemma, Mistral, etc.)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemma-2-9b-it

# Option 2: Groq (hosted Gemma, Llama — fast inference)
# AI_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=gemma2-9b-it

# Option 3: Ollama (local inference — full privacy)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2:9b

# ─── SerpApi (live web search) ───────────────────────────
# Optional: enables live crisis information retrieval (Qualifies for Best Use of SerpApi)
SERPAPI_KEY=your_serpapi_key

# ─── ElevenLabs (Emergency Voice Narration) ──────────────
# Optional: enables ultra-realistic emergency broadcaster voice (Qualifies for Best Use of ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Client URL (for CORS) ──────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Demo Mode ───────────────────────────────────────────
# Set to true to enable demo without API keys
DEMO_MODE=true
